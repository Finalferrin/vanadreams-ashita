<UserControl x:Class="Vanadreams.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ What it does"/>
                <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14"
                           Text="Installs Final Fantasy XI, already updated to the version Vanadreams runs. No PlayOnline and no Square Enix account: the launcher downloads the game, checks every part, and sets it up so Play works. Windows asks for permission once at the end, to register the game."/>
                <Grid Grid.Row="2" x:Name="Facts">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Muted}" Text="Version" Margin="0,0,0,5"/>
                    <TextBlock Grid.Column="1" x:Name="VersionText" Style="{StaticResource Mono}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Download" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SizeText" Style="{StaticResource Mono}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Install to" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FolderText" Style="{StaticResource Mono}" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="Game now" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FoundText" Style="{StaticResource Mono}" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <StackPanel Grid.Row="4">
                    <ProgressBar x:Name="Progress" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Game"/>
                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource Display40}" FontSize="26" Text="Final Fantasy XI"/>
                    <TextBlock x:Name="State" Style="{StaticResource Mono}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="InstallButton" Style="{StaticResource GoldButton}" Content="Install game" Click="Install_Click" Margin="0,0,0,8"/>
                    <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Content="Change folder" Click="Folder_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

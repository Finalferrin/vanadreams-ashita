<UserControl x:Class="Vanadreams.Pages.CapturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Snapshots"/>
                <ListBox Grid.Row="1" x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="52" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="hand" Style="{StaticResource Hand}" Visibility="Hidden" FontSize="22"/>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="hand" Property="Visibility" Value="Visible"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MenuItemText}" FontSize="19"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Text="Snapshots come from the charcapture addon: load it on the character you want to bring and type /capture. Files live in config\charcapture."/>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Send to Vanadreams"/>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="SelName" Style="{StaticResource Display40}" FontSize="26" Text="—"/>
                    <TextBlock x:Name="SelMeta" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SelUser" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="Result" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="SendButton" Style="{StaticResource GoldButton}" Content="Send to Vanadreams" Click="Send_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="Open snapshot folder" Click="Folder_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

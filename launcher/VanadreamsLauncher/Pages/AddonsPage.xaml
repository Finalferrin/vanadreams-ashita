<UserControl x:Class="Vanadreams.Pages.AddonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource Eyebrow}" Text="✦ Your addons"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24" Margin="0,0,14,0" Background="Transparent" MouseLeftButtonUp="Row_Click" Tag="{Binding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Hand}" FontSize="18" Margin="0,-3,0,0" Visibility="{Binding HandVisibility}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding HasV4}" VerticalAlignment="Center" Click="Check_Click" Tag="{Binding}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="10" FontWeight="ExtraBold" Foreground="{Binding TagBrush}" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Selected"/>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="ItemName" Style="{StaticResource Display40}" FontSize="26" Text="—"/>
                    <TextBlock x:Name="ItemMeta" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ItemDesc" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ItemState" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ItemV3" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="Progress" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="InstallButton" Style="{StaticResource GoldButton}" Content="Install" Click="Install_Click" Margin="0,0,0,8"/>
                    <Button x:Name="DocsButton" Style="{StaticResource GhostButton}" Content="Read the docs" Click="Docs_Click" Margin="0,0,0,8"/>
                    <Button x:Name="ConfigButton" Style="{StaticResource GhostButton}" Content="Open config folder" Click="Config_Click" Margin="0,0,0,12"/>
                    <Grid>
                        <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Click="Back_Click"/>
                        <Button Style="{StaticResource GoldButton}" Content="Save" HorizontalAlignment="Right" Click="Save_Click"/>
                    </Grid>
                    <TextBlock x:Name="Footer" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Text="Save writes scripts\vanadreams.txt and the POL plugin flags."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

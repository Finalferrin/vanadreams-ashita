<UserControl x:Class="Vanadreams.Pages.VanatunesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ What it is"/>
                <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"
                           Text="A music player that runs inside the game. It plays the Vanadreams songs and any you add yourself, shuffled, wherever you are. While one of ours plays, the game's own music is turned down, and it comes back when ours stops."/>
                <TextBlock Grid.Row="2" Style="{StaticResource Eyebrow}" Text="✦ How to use it"/>
                <StackPanel Grid.Row="3">
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" Text="1.  In game, type /vanatunes to open the player's window."/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" Text="2.  Press Play. Shuffle, Next and Volume are on the window, and a song in the list plays when you click it."/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" Text="3.  Your own songs: put mp3 or wav files in the Vanadreams Music folder on your Desktop (Open my music folder, right). They join the list; /vanatunes rescan picks up new ones without leaving the game."/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" Text="4.  My music or Game music, at the top of the window, switches back to the game's own soundtrack and pauses ours."/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Text="5.  New Vanadreams songs come out now and then: Get new songs fetches them."/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Music"/>
                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource Display40}" FontSize="26" Text="vanatunes"/>
                    <TextBlock x:Name="State" Style="{StaticResource Mono}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <CheckBox x:Name="EnabledBox" Content="Load the music player at startup" Click="Enabled_Click"/>
                    <TextBlock x:Name="Songs" Style="{StaticResource Mono}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Note" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource GhostButton}" Content="Open my music folder" Click="Folder_Click" Margin="0,0,0,8"/>
                    <Button x:Name="GetButton" Style="{StaticResource GhostButton}" Content="Get new songs" Click="Get_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Left" Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

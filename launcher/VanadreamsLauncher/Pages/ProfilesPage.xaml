<UserControl x:Class="Vanadreams.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Profiles"/>
                <ListBox Grid.Row="1" x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="List_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Height="34" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="hand" Style="{StaticResource Hand}" Visibility="Hidden" FontSize="22"/>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="hand" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource MenuItemText}" FontSize="18" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="New" Padding="12,6" Click="New_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Retail" Padding="12,6" Margin="6,0,0,0" Click="Retail_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Copy" Padding="12,6" Margin="6,0,0,0" Click="Duplicate_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="Delete" Padding="12,6" Margin="6,0,0,0" Click="Delete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Profile"/>
                <Grid Grid.Row="1" x:Name="Form">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                        <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="NameBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Server address" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerBox" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="TailscaleBox" Content="Over Tailscale" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="Tailscale_Changed" Unchecked="Tailscale_Changed"
                                  ToolTip="For when your router or internet provider blocks the game. Install Tailscale, accept the share of the Vanadreams server you were sent, then tick this and Save."/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="Password" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PassBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="Boot file" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="BootBox" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="…" Padding="10,4" Margin="6,0,0,0" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="5" Text="Extra loader args" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="ExtraBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="6" Text="Window mode" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ModeBox" VerticalAlignment="Center" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="7" Text="Window size" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="WidthBox" Width="70" VerticalAlignment="Center"/>
                        <TextBlock Text=" × " VerticalAlignment="Center"/>
                        <TextBox x:Name="HeightBox" Width="70" VerticalAlignment="Center"/>
                        <TextBlock Text="   menu " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBox x:Name="MenuWBox" Width="60" VerticalAlignment="Center"/>
                        <TextBlock Text=" × " VerticalAlignment="Center"/>
                        <TextBox x:Name="MenuHBox" Width="60" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="Background" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"
                                ToolTip="The resolution the game draws the world at. Higher is sharper and asks more of your graphics card: twice or four times the window size is usual, 4096 × 4096 is common. Leave blank for the game's own default.">
                        <TextBox x:Name="BgWBox" Width="70" VerticalAlignment="Center"/>
                        <TextBlock Text=" × " VerticalAlignment="Center"/>
                        <TextBox x:Name="BgHBox" Width="70" VerticalAlignment="Center"/>
                        <TextBlock Text="   sharper world, blank for default" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Row="9" Grid.Column="1" x:Name="AutoCloseBox" Content="Close the launcher after launching" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="Note" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Warn}"/>
                    <Button Style="{StaticResource GhostButton}" Content="Back" Click="Back_Click"/>
                    <Button Style="{StaticResource GoldButton}" Content="Save" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

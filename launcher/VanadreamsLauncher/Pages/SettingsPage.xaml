<UserControl x:Class="Vanadreams.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Border Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Settings"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
                        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ashita folder" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="AshitaBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="FFXI folder override" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="FfxiBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Catalogue address" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="CatalogBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="Status address" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="StatusBox" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="Expected client version" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="VerBox" Width="140" VerticalAlignment="Center"/>
                        <TextBlock Text="   lock " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LockBox" Width="220" VerticalAlignment="Center">
                            <ComboBoxItem Content="0 · any version"/>
                            <ComboBoxItem Content="1 · exact month only"/>
                            <ComboBoxItem Content="2 · matching or newer"/>
                        </ComboBox>
                        <TextBlock Text="  (the status route overrides these when it carries them)" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Text="Detected FFXI folder" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetectedBox" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Refresh catalogue" Click="Catalog_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open data folder" Margin="8,0,0,0" Click="Data_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open log" Margin="8,0,0,0" Click="Log_Click"/>
                        <Button x:Name="ShortcutsButton" Style="{StaticResource GhostButton}" Content="Install shortcuts" Margin="8,0,0,0" Click="Shortcuts_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <TextBlock x:Name="About" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="Note" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="Back" Click="Back_Click"/>
                        <Button Style="{StaticResource GoldButton}" Content="Save" Margin="8,0,0,0" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

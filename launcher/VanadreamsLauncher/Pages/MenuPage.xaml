<UserControl x:Class="Vanadreams.Pages.MenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Margin="40,36,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- the moon, small, top right -->
        <Ellipse Grid.Column="2" Width="84" Height="84" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-22,-4,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.38,0.34" Center="0.45,0.4" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="#FFFFF2C8" Offset="0"/>
                    <GradientStop Color="#FFE9C77C" Offset="0.4"/>
                    <GradientStop Color="#FFC79A4E" Offset="0.78"/>
                    <GradientStop Color="#FF9C6F33" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFF1CD78" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- profile card -->
        <Border Grid.Column="0" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Profile"/>
                <TextBlock Grid.Row="1" x:Name="ProfileName" Style="{StaticResource Display40}" Text="—" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" x:Name="ProfileServer" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
                <Grid Grid.Row="3" x:Name="Facts">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="PlayButton" Style="{StaticResource GoldButton}" Content="▶  Play" Click="Play_Click" MinWidth="120"/>
                    <Button Style="{StaticResource GhostButton}" Content="Edit profile" Margin="10,0,0,0" Click="Edit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- command list -->
        <Border Grid.Column="2" Style="{StaticResource Box}" Height="376" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="✦ Menu"/>
                <ItemsControl x:Name="Commands">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="28" Background="Transparent" MouseLeftButtonUp="Command_Click" MouseEnter="Command_Hover" Tag="{Binding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Hand}" Visibility="{Binding HandVisibility}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource MenuItemText}" FontSize="19" Opacity="{Binding Opacity}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
